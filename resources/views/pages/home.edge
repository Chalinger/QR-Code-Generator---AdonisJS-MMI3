{{--
  Accueil. Le QR code de droite est purement décoratif (il ne contient
  aucune donnée) : une grille de 21 × 21 modules, avec les trois motifs de
  repérage dans les coins et des modules répartis de façon déterministe.
--}}
@let(gridSize = 21)
@let(isFinder = (x, y) => (x < 8 && y < 8) || (x > 12 && y < 8) || (x < 8 && y > 12))
@let(modules = Array.from({ length: gridSize * gridSize }, (_, i) => ({ x: i % gridSize, y: Math.floor(i / gridSize) }))
  .filter((m) => !isFinder(m.x, m.y) && ((m.x * 73856093) ^ (m.y * 19349663)) % 7 < 3))
@let(finders = [[0, 0], [14, 0], [0, 14]])

@layouts.app()
  <section class="hero">
    <div class="hero__text">
      <p class="hero__kicker mono">Générateur de QR codes</p>
      <h1 class="hero__title">Des QR codes à vos couleurs, et un historique pour les retrouver.</h1>
      <p class="hero__lead">
        Transformez un lien ou un texte en QR code, réglez ses couleurs, sa taille et sa résistance aux erreurs, puis téléchargez-le en PNG.
      </p>
      <div class="hero__actions">
        @if(auth?.user)
          @link({ route: 'qr_codes.create', class: 'btn btn--primary' })
            Créer un QR code
          @end
          @link({ route: 'qr_codes.index', class: 'btn btn--secondary' })
            Mes QR codes
          @end
        @else
          @link({ route: 'new_account.create', class: 'btn btn--primary' })
            Créer un compte gratuit
          @end
          @link({ route: 'session.create', class: 'btn btn--secondary' })
            J'ai déjà un compte
          @end
        @end
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="viewfinder viewfinder--lg">
        <svg class="hero-qr" viewBox="-2 -2 {{ gridSize + 4 }} {{ gridSize + 4 }}" width="320" height="320">
          <rect x="-2" y="-2" width="{{ gridSize + 4 }}" height="{{ gridSize + 4 }}" fill="#ffffff" />
          @each(finder in finders)
            <g class="hero-qr__finder" transform="translate({{ finder[0] }} {{ finder[1] }})">
              <path fill="currentColor" fill-rule="evenodd" d="M0 0h7v7H0zM1 1v5h5V1z" />
              <rect fill="currentColor" x="2" y="2" width="3" height="3" />
            </g>
          @end
          @each(module in modules)
            <rect class="hero-qr__module" x="{{ module.x }}" y="{{ module.y }}" width="1" height="1" style="--d: {{ (module.x + module.y) * 30 }}ms" />
          @end
        </svg>
      </div>
    </div>
  </section>

  <section class="steps" aria-label="Fonctionnement">
    <ol class="steps__list">
      <li class="steps__item">
        <span class="steps__num mono">01</span>
        <h2 class="steps__title">Le contenu</h2>
        <p>Un lien (http:// ou https://) ou un texte libre, jusqu'à 400 caractères.</p>
      </li>
      <li class="steps__item">
        <span class="steps__num mono">02</span>
        <h2 class="steps__title">L'apparence</h2>
        <p>Couleur des modules et du fond, taille de l'image, niveau de correction d'erreur.</p>
      </li>
      <li class="steps__item">
        <span class="steps__num mono">03</span>
        <h2 class="steps__title">Le téléchargement</h2>
        <p>Une image PNG prête à imprimer, et un historique pour modifier ou supprimer vos codes.</p>
      </li>
    </ol>
  </section>
@end
