{{-- Affichée en production seulement (renderStatusPages dans app/exceptions/handler.ts) --}}
@layouts.app({ title: 'Erreur' })
  <div class="error-page">
    <p class="error-page__code mono">{{ error?.status || 500 }}</p>
    <h1 class="error-page__title">Une erreur est survenue</h1>
    <p class="error-page__text">
      Le serveur a rencontré un problème inattendu. Réessayez dans quelques instants.
    </p>
    @link({ route: 'home', class: 'btn btn--primary' })
      Retour à l'accueil
    @end
  </div>
@end
