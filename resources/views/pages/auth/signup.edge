@layouts.app({ title: 'Inscription' })
  <div class="auth">
    <div class="auth__card">
      <h1 class="auth__title">Créer un compte</h1>
      <p class="auth__sub">Gratuit, pour garder un historique de vos QR codes.</p>

      @form({
        route: 'new_account.store',
        class: 'auth__form',
        novalidate: true,
        'x-data': '{ submitting: false }',
        'x-on:submit': 'submitting = true',
      })
        @field.root({ name: 'fullName' })
          @!field.label({ text: 'Nom complet (facultatif)' })
          @!input.control({ autocomplete: 'name', placeholder: 'Ada Lovelace' })
          @!field.error()
        @end
        @field.root({ name: 'email' })
          @!field.label({ text: 'Adresse e-mail' })
          @!input.control({
            type: 'email',
            autocomplete: 'email',
            placeholder: 'vous@exemple.fr',
          })
          @!field.error()
        @end
        @field.root({ name: 'password' })
          @!field.label({ text: 'Mot de passe' })
          @!input.control({ type: 'password', autocomplete: 'new-password' })
          <span class="field__hint">Entre 8 et 32 caractères.</span>
          @!field.error()
        @end
        @field.root({ name: 'passwordConfirmation' })
          @!field.label({ text: 'Confirmation du mot de passe' })
          @!input.control({ type: 'password', autocomplete: 'new-password' })
          @!field.error()
        @end
        @!button({
          text: 'Créer mon compte',
          type: 'submit',
          block: true,
          'x-bind:disabled': 'submitting',
          'x-text': "submitting ? 'Un instant…' : 'Créer mon compte'",
        })
      @end

      <p class="auth__foot">
        Déjà un compte ?
        @link({ route: 'session.create', class: 'il' })
          Se connecter
        @end
      </p>
    </div>
  </div>
@end
