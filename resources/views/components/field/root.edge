{{--
  Entoure un champ de formulaire et partage avec ses enfants (label, control,
  error) son nom, son id, la saisie précédente (old) et ses erreurs de
  validation (inputErrorsBag, rempli par validateUsing()).
--}}
@let(fieldKey = $props.get('name'))
@inject({
  name: fieldKey,
  id: $props.get('id') ?? fieldKey,
  oldValue: old(fieldKey) || '',
  errors: flashMessages.get('inputErrorsBag', {})[fieldKey],
  hasErrors: fieldKey in flashMessages.get('inputErrorsBag', {}),
})

<div class="field">{{{ await $slots.main() }}}</div>
