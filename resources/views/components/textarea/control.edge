@let(classes = ['field__input'])

{{--
  {{ }} et non {{{ }}} : la valeur doit être échappée, sinon un contenu
  comme "</textarea><script>…" serait interprété comme du HTML.
--}}
<textarea {{
  $props
    .except(['value'])
    .merge({
      name: $context.name,
      id: $context.id,
      class: classes,
      'aria-invalid': $context.hasErrors ? 'true' : false,
      'data-invalid': $context.hasErrors ? 'true' : false,
      'aria-describedby': $context.hasErrors ? `${$context.id}-error` : '',
    })
    .toAttrs()
}}>{{ $context.oldValue || $props.get('value') || '' }}</textarea>
