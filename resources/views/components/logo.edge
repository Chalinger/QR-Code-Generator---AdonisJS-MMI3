{{--
  Logo : un « motif de repérage », l'un des trois carrés présents dans les
  coins de tout QR code (7 × 7 modules).
--}}
@link({ route: 'home', class: 'logo', 'aria-label': 'Générateur de QR codes, accueil' })
  <svg class="logo__mark" width="28" height="28" viewBox="0 0 7 7" aria-hidden="true">
    <path fill="currentColor" fill-rule="evenodd" d="M0 0h7v7H0zM1 1v5h5V1z" />
    <rect fill="currentColor" x="2" y="2" width="3" height="3" />
  </svg>
  <span class="logo__text">QR<span class="logo__light">codes</span></span>
@end
